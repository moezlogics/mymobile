# ═══════════════════════════════════════════════════════════════════════
# mymobile.pk — production environment templates (copy each block into the
# matching .env on the server; generate every secret fresh, never reuse
# zmobiles.pk values).   openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════

# ── backend/.env ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3102
HOST=0.0.0.0
DATABASE_URL=postgres://mymobile:CHANGE_ME@127.0.0.1:5432/mymobilepkdb
REDIS_URL=redis://127.0.0.1:6379/3
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
STORE_CORS=https://mymobile.pk,https://www.mymobile.pk
ADMIN_CORS=https://api.mymobile.pk,https://mymobile.pk
AUTH_CORS=https://mymobile.pk,https://api.mymobile.pk
MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_FF_ADMIN_UI=true
MEDUSA_BACKEND_URL=https://api.mymobile.pk
STOREFRONT_URL=https://mymobile.pk
REVALIDATE_SECRET=CHANGE_ME
CDN_PUBLIC_URL=https://cdn.mymobile.pk
CDN_API_KEY=CHANGE_ME_SAME_AS_CDN
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=CHANGE_ME
AGENTIC_COMMERCE_SIGNATURE_KEY=CHANGE_ME
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= SMTP_FROM=
# GA_MEASUREMENT_ID= GA_API_SECRET=

# ── cdn/.env ───────────────────────────────────────────────────────────
PORT=3101
NODE_ENV=production
CORS_ORIGINS=https://mymobile.pk,https://api.mymobile.pk
CDN_PUBLIC_URL=https://cdn.mymobile.pk
CDN_API_KEY=CHANGE_ME_SAME_AS_BACKEND
UPLOAD_DIR=/home/mymobile-cdn/htdocs/cdn.mymobile.pk/uploads
MAX_FILE_SIZE_MB=20
WEBP_QUALITY=90
MAX_WIDTH=1920
THUMB_WIDTH=600
AUTO_ALT_ENABLED=false

# ── frontend/.env ──────────────────────────────────────────────────────
MEDUSA_BACKEND_URL=http://127.0.0.1:3102
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.mymobile.pk
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_FROM_MIGRATION_OUTPUT
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=sc_FROM_MIGRATION_OUTPUT
NEXT_PUBLIC_BASE_URL=https://mymobile.pk
NEXT_PUBLIC_DEFAULT_REGION=pk
REVALIDATE_SECRET=CHANGE_ME_SAME_AS_BACKEND
NEXT_PUBLIC_CDN_URL=https://cdn.mymobile.pk
CDN_PUBLIC_URL=https://cdn.mymobile.pk
CDN_INTERNAL_URL=http://127.0.0.1:3101
NEXT_PUBLIC_MEILISEARCH_HOST=https://mymobile.pk/api/search
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
NEXT_PUBLIC_MEILISEARCH_PRODUCT_INDEX_NAME=products
MEILISEARCH_INTERNAL_HOST=http://127.0.0.1:7700
MEILISEARCH_SEARCH_KEY=CHANGE_ME_SEARCH_ONLY_KEY
